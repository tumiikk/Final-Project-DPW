# ============================================================
# Contoh konfigurasi. Salin menjadi file ".env" lalu isi nilainya.
#   Windows (Laragon Terminal) : copy .env.example .env
#   Linux / macOS              : cp .env.example .env
# File .env berisi password, JANGAN di-commit ke GitHub (sudah ada di .gitignore).
# Di Railway, isi nilai yang sama di tab "Variables" (file .env tidak dipakai di sana).
# ============================================================

# local = pengembangan di komputer, production = server/hosting
APP_ENV=local
# true hanya untuk lokal (menampilkan detail error). Di production WAJIB false.
APP_DEBUG=true
# Alamat website; dipakai untuk link undangan personal tamu.
# Laragon: http://wedding-invitationkel5.test   |   Railway: https://nama-app.up.railway.app
APP_URL=http://wedding-invitationkel5.test
# Zona waktu penyimpanan waktu di database (sama dengan versi Laravel)
APP_TIMEZONE=UTC

# ---------- Database MySQL lokal (Laragon) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wedding_invitation
DB_USERNAME=root
# Laragon bawaan: password root kosong
DB_PASSWORD=

# ---------- Database Railway ----------
# Tidak perlu DB_* bila service web di Railway sudah diberi variabel referensi:
#   MYSQLHOST=${{MySQL.MYSQLHOST}}  MYSQLPORT=${{MySQL.MYSQLPORT}}  MYSQLDATABASE=${{MySQL.MYSQLDATABASE}}
#   MYSQLUSER=${{MySQL.MYSQLUSER}}  MYSQLPASSWORD=${{MySQL.MYSQLPASSWORD}}
# atau cukup satu variabel: MYSQL_URL=${{MySQL.MYSQL_URL}}

# ---------- Session login admin ----------
SESSION_LIFETIME=120
# Kosongkan agar otomatis (cookie aman bila website dibuka lewat HTTPS)
SESSION_SECURE_COOKIE=

# ---------- Akun admin awal (dibuat oleh: php cli/install.php) ----------
ADMIN_NAME="Admin"
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# Wajib diisi sendiri, minimal 10 karakter. Kosong = akun admin tidak dibuat.
ADMIN_PASSWORD=
